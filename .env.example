# =============================================================
# LogiSmart — variables d'environnement (exemple)
# Copier vers .env puis remplir. Ne JAMAIS committer .env.
# =============================================================

# --- Database ---
# Dev local avec le serveur Postgres embarqué (npm run db:start) : port 5433
# Avec docker-compose (service `db`) : postgresql://postgres:postgres@localhost:5432/logismart
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/logismart?schema=public"
# Schéma Prisma
DATABASE_SCHEMA="public"
# Appliquer les migrations Prisma au démarrage de l'API (recommandé en conteneur).
AUTO_MIGRATE="false"

# --- API ---
NODE_ENV="development"
API_PORT=4000
API_HOST="0.0.0.0"
# Origine du frontend autorisée (CORS). Séparer par une virgule si plusieurs.
FRONTEND_URL="http://localhost:5173"

# --- Authentification ---
# Générer avec : openssl rand -base64 48
JWT_SECRET="change-me-in-production-openssl-rand-base64-48"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Cookie signé (sessions de refresh)
COOKIE_SECRET="change-me-too-openssl-rand-base64-48"
# En production derrière HTTPS : "true"
COOKIE_SECURE="false"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- IA (LLM) ---
# Fournisseur : "openai" | "anthropic" | "xai" | "ollama" | "mock"
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL=""
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=30000

# --- Embeddings (RAG) ---
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_BASE_URL=""
EMBEDDING_DIMENSIONS=1536

# --- Stockage (preuves de livraison, CV, documents) ---
# "local" | "s3" | "cloudinary" | "supabase"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads"
STORAGE_URL="http://localhost:4000/uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Temps réel ---
SOCKET_PATH="/socket.io"
# Fréquence d'envoi de position côté client (ms) — ne pas descendre sous 3000
LOCATION_INTERVAL_MS=5000
LOCATION_MIN_ACCURACY_M=50

# --- Frontend (build Vite) ---
VITE_API_URL="http://localhost:4000"
VITE_SOCKET_URL="http://localhost:4000"
VITE_APP_NAME="LogiSmart"

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Log ---
# "debug" | "info" | "warn" | "error" | "silent"
LOG_LEVEL="debug"
