{
  "name": "@logismart/local-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LogiSmart Desktop — client local Electron pour les livreurs",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron .",
    "build:main": "tsc -p electron/tsconfig.json"
  },
  "dependencies": {
    "@logismart/shared": "*",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^33.4.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
